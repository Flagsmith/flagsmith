DATABASE_URL=postgresql://postgres:password@localhost:5432/flagsmith
ANALYTICS_DATABASE_URL=postgresql://postgres:password@localhost:5433/analytics
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
