{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "security:only-security-updates",
    ":semanticCommitTypeAll(deps)"
  ],
  "gitIgnoredAuthors": ["flagsmith-engineering[bot]@users.noreply.github.com"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "packageRules": [
    {
      "matchManagers": ["pep621"],
      "matchFileNames": ["api/**"],
      "addLabels": ["api", "dependencies"],
      "semanticCommitScope": "API"
    },
    {
      "matchManagers": ["pep621"],
      "matchFileNames": ["mcp/**"],
      "addLabels": ["mcp", "dependencies"],
      "semanticCommitScope": "MCP"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/**"],
      "addLabels": ["front-end", "dependencies"],
      "semanticCommitScope": "Frontend"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["docs/**"],
      "addLabels": ["docs", "dependencies"],
      "semanticCommitScope": "Docs"
    },
    {
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/**"],
      "addLabels": ["ci", "dependencies"],
      "semanticCommitScope": "CI"
    },
    {
      "description": "Eagerly bump internal Flagsmith packages on every release",
      "matchPackageNames": ["flagsmith-common", "flagsmith-private"],
      "enabled": true,
      "rangeStrategy": "bump"
    },
    {
      "description": "Hold back automated dependency updates until a release has been public for a week. For npm this is the only enforcement we have: npm's own min-release-age needs npm >= 11.10, which no Node 22 release bundles, and it never applies to npm ci. For Python it complements exclude-newer in pyproject.toml, which is what covers transitive dependencies and lock file maintenance.",
      "matchManagers": ["npm", "pep621"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Exempt internal Flagsmith packages from the cooldown, so we can publish one and consume it immediately. Python packages are listed individually because they share no common prefix; keep in sync with exclude-newer-package in api/pyproject.toml.",
      "matchPackageNames": [
        "@flagsmith/**",
        "flagsmith",
        "flagsmith-common",
        "flagsmith-private",
        "flagsmith-flag-engine",
        "flagsmith-sql-flag-engine",
        "openfeature-provider-flagsmith"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Re-enable lock file maintenance, which security:only-security-updates disables. Keep last with an empty scope to ensure commit scope is applied correctly.",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "enabled": true,
      "semanticCommitScope": ""
    }
  ],
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null
  },
  "semanticCommitScope": ""
}
