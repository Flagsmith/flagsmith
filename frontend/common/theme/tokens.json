      "tertiary": { "cssVar": "--color-text-tertiary", "light": "#656d7b", "dark": "rgba(255, 255, 255, 0.48)", "description": "Placeholders and hint text. In light mode, dark enough to clear 4.5:1 on surface-default." },
      "disabled": { "cssVar": "--color-text-disabled", "light": "#9da4ae", "dark": "rgba(255, 255, 255, 0.32)" },
      "action": { "cssVar": "--color-text-action", "light": "#6837fc", "dark": "#9168fd" },
      "danger": { "cssVar": "--color-text-danger", "light": "#bb1720", "dark": "#f5a5a2", "description": "In light mode, darker than border/icon danger to clear 4.5:1 on the tint." },
      "success": { "cssVar": "--color-text-success", "light": "#35795a", "dark": "#6ad0a1", "description": "In light mode, darker than border/icon success to clear 4.5:1 on the tint." },
      "warning": { "cssVar": "--color-text-warning", "light": "#744800", "dark": "#ffbc05", "description": "In light mode, darker than border/icon warning to clear 4.5:1 on the tint." },
      "info": { "cssVar": "--color-text-info", "light": "#0767b9", "dark": "#0fa5fc" }
    },
