      "hover": { "cssVar": "--color-surface-hover", "light": "rgba(0, 0, 0, 0.08)", "dark": "rgba(255, 255, 255, 0.08)", "_comment": "neutral-1000/neutral-0 at alpha" },
      "active": { "cssVar": "--color-surface-active", "light": "rgba(0, 0, 0, 0.16)", "dark": "rgba(255, 255, 255, 0.16)", "_comment": "neutral-1000/neutral-0 at alpha" },
      "action": { "cssVar": "--color-surface-action", "light": "#6837fc", "dark": "#9168fd" },
