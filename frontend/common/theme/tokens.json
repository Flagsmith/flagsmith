      "action-tint": { "cssVar": "--color-surface-action-tint", "light": "rgba(104, 55, 252, 0.12)", "dark": "rgba(145, 104, 253, 0.16)", "description": "Selected/highlighted surface that keeps its purple cast in dark mode, unlike the neutral dark alphas of action-subtle/action-muted." },
      "danger": { "cssVar": "--color-surface-danger", "light": "#fce5e4", "dark": "#7a0e18" },
      "success": { "cssVar": "--color-surface-success", "light": "#f0fff2", "dark": "#1b392b" },
      "warning": { "cssVar": "--color-surface-warning", "light": "#fff7cd", "dark": "#744800" },
