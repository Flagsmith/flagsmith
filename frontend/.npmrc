# Requires npm >= 11.10.0; older npm silently ignores these and installs anyway.
# Node 22 bundles npm 10.9.x, so this is inert until we move to Node 24+.
# Only applies when a lock file is resolved (npm install/update) — never npm ci.
# Renovate enforces the same cooldown for automated updates, see renovate.json.
min-release-age=7
min-release-age-exclude[]=@flagsmith/*
