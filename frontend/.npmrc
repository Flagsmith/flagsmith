# Release-age cooldown for npm. Enforced by npm itself rather than Renovate,
# because only npm understands the per-package exclusion below: Renovate passes
# a single global --before to npm and falls back to no cutoff at all if that
# errors. renovate.json pins an npm version that supports these settings.
# Applies when a lock file is resolved (npm install/update), never to npm ci.
# Needs npm >= 11.10.0; older npm ignores these and installs anyway.
min-release-age=7
min-release-age-exclude[]=@flagsmith/*
