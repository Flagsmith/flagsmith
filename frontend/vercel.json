{
    "version": 2,
    "functions": {
        "api/index.js": {
            "includeFiles": "{CI_COMMIT_SHA,public/static/index.handlebars}"
        }
    },
    "headers": [
        {
            "source": "/static/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api"
        }
    ]
}
