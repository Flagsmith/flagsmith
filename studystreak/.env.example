# Copy to .env.local and fill in. .env.local is ignored by Git; never commit real keys.
# Production and Simulation are separate Flagsmith environments: never mix their keys.

# Production environment, client-side key. Public by design and sent to the browser.
# Must not be a server-side key (those start with "ser.").
FLAGSMITH_CLIENT_ENVIRONMENT_KEY=

# Production environment, server-side key. Secret. Read only by the signup API route to record signed_up.
FLAGSMITH_SERVER_KEY=

# Simulation environment, server-side key. Secret. Read only by scripts/simulate-traffic.ts (Milestone 6).
# Never set this in the deployed application.
FLAGSMITH_SIMULATION_SERVER_KEY=
